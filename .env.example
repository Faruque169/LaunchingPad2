# Copy this file to ".env" (same folder as app.py) and fill in the values.
# No quotes needed. Paste the Neon string exactly as copied, including & signs.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require
ADMIN_PASSWORD=choose-a-strong-password
SECRET_KEY=any-long-random-text
BASE_URL=http://localhost:5000
